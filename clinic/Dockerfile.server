# syntax=docker/dockerfile:1
# Builds the Medplum server from THIS repo's source code (not the published image),
# so local modifications are included in the production image.
#
# Build from the repo root:
#   docker build -f clinic/Dockerfile.server -t clinic/medplum-server .
# (clinic/docker-compose.yml does this for you)

# Stage 1: compile TypeScript for the server and its workspace dependencies
FROM node:24-slim AS builder
ENV TURBO_TELEMETRY_DISABLED=1
WORKDIR /usr/src/medplum
COPY . .
RUN --mount=type=cache,target=/root/.npm npm ci
RUN npx turbo run build --filter=@medplum/server

# Stage 2: install production-only dependencies for the server workspaces.
# Mirrors scripts/build-docker-server.sh: only the package.json files of the
# server and its runtime deps are present, so npm ci installs just what the
# server needs at runtime.
FROM node:24-slim AS deps
ENV NODE_ENV=production
WORKDIR /usr/src/medplum
COPY package.json package-lock.json ./
COPY packages/bot-layer/package.json packages/bot-layer/
COPY packages/ccda/package.json packages/ccda/
COPY packages/core/package.json packages/core/
COPY packages/definitions/package.json packages/definitions/
COPY packages/fhir-router/package.json packages/fhir-router/
COPY packages/server/package.json packages/server/
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev && rm package-lock.json

# Stage 3: runtime image
FROM node:24-slim AS runtime
ENV NODE_ENV=production
WORKDIR /usr/src/medplum
COPY --from=deps /usr/src/medplum/ ./
COPY --from=builder /usr/src/medplum/packages/ccda/dist packages/ccda/dist
COPY --from=builder /usr/src/medplum/packages/core/dist packages/core/dist
COPY --from=builder /usr/src/medplum/packages/definitions/dist packages/definitions/dist
COPY --from=builder /usr/src/medplum/packages/fhir-router/dist packages/fhir-router/dist
COPY --from=builder /usr/src/medplum/packages/server/dist packages/server/dist
COPY LICENSE.txt NOTICE ./

EXPOSE 8103

ENTRYPOINT [ "node", "--experimental-loader=@opentelemetry/instrumentation/hook.mjs", "--import", "./packages/server/dist/otel/instrumentation.js", "packages/server/dist/index.js" ]
