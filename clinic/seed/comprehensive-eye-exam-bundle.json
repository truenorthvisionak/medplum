  "entry": [
    {
      "fullUrl": "urn:uuid:5f1c9b0e-2a4d-4e8f-9c3b-7d6a8e5f4c21",
      "resource": {
        "resourceType": "Questionnaire",
        "url": "urn:clinic:questionnaire:eye-exam-history",
        "status": "active",
        "name": "Eye Exam History",
        "title": "History & Chief Complaint",
        "code": [
          {
            "system": "http://snomed.info/sct",
            "code": "422979000",
            "display": "History taking"
          }
        ],
        "item": [
          {
            "linkId": "cc",
            "type": "text",
            "required": true,
            "text": "Chief complaint"
          },
          {
            "linkId": "hpi",
            "type": "text",
            "text": "History of present illness (onset, duration, laterality, associated symptoms)"
          },
          {
            "linkId": "ocular-history",
            "type": "text",
            "text": "Ocular history (surgeries, trauma, amblyopia, family history of glaucoma/AMD)"
          },
          {
            "linkId": "correction-wear",
            "type": "choice",
            "text": "Current correction",
            "answerOption": [
              { "valueString": "None" },
              { "valueString": "Glasses" },
              { "valueString": "Contact lenses" },
              { "valueString": "Glasses and contact lenses" }
            ]
          },
          {
            "linkId": "last-exam",
            "type": "date",
            "text": "Date of last eye exam (approximate)"
          }
        ]
      },
      "request": { "method": "POST", "url": "Questionnaire" }
    },
    {
      "fullUrl": "urn:uuid:6a2d8c1f-3b5e-4f90-8d4c-8e7b9f6a5d32",
      "resource": {
        "resourceType": "Questionnaire",
        "url": "urn:clinic:questionnaire:eye-exam-pretest-entrance",
        "status": "active",
        "name": "Eye Exam Entrance Testing",
        "title": "Entrance Testing & Dilation",
        "code": [
          {
            "system": "http://snomed.info/sct",
            "code": "36228007",
            "display": "Ophthalmic examination and evaluation"
          }
        ],
        "item": [
          {
            "linkId": "note-structured",
            "type": "display",
            "text": "Record visual acuity, refraction, and IOP in the patient's Eye Exam tab — those are stored as structured, coded observations. This form covers the remaining entrance tests."
          },
          {
            "linkId": "pupils",
            "type": "choice",
            "text": "Pupils",
            "answerOption": [
              { "valueString": "PERRLA, no APD" },
              { "valueString": "Abnormal (describe below)" }
            ]
          },
          {
            "linkId": "pupils-notes",
            "type": "text",
            "text": "Pupil findings (if abnormal)"
          },
          {
            "linkId": "eoms",
            "type": "choice",
            "text": "Extraocular motilities",
            "answerOption": [
              { "valueString": "Full and smooth OU" },
              { "valueString": "Restricted (describe below)" }
            ]
          },
          {
            "linkId": "eoms-notes",
            "type": "text",
            "text": "EOM findings (if restricted)"
          },
          {
            "linkId": "cvf",
            "type": "choice",
            "text": "Confrontation visual fields",
            "answerOption": [
              { "valueString": "Full to finger counting OD and OS" },
              { "valueString": "Constricted / defect (describe below)" }
            ]
          },
          {
            "linkId": "cvf-notes",
            "type": "text",
            "text": "Confrontation field findings (if abnormal)"
          },
          {
            "linkId": "pachymetry-od",
            "type": "integer",
            "text": "Pachymetry OD (µm)"
          },
          {
            "linkId": "pachymetry-os",
            "type": "integer",
            "text": "Pachymetry OS (µm)"
          },
          {
            "linkId": "dilated",
            "type": "boolean",
            "text": "Patient dilated this visit"
          },
          {
            "linkId": "dilation-agent",
            "type": "choice",
            "text": "Dilation agent",
            "answerOption": [
              { "valueString": "Tropicamide 1%" },
              { "valueString": "Tropicamide 1% + Phenylephrine 2.5%" },
              { "valueString": "Cyclopentolate 1%" },
              { "valueString": "Other (note in comments)" }
            ]
          },
          {
            "linkId": "dilation-time",
            "type": "string",
            "text": "Time drops instilled"
          }
        ]
      },
      "request": { "method": "POST", "url": "Questionnaire" }
    },
    {
      "fullUrl": "urn:uuid:7b3e9d20-4c6f-4a01-9e5d-9f8c0a7b6e43",
