        "url": "urn:clinic:questionnaire:eye-exam-assessment-plan",
        "status": "active",
        "name": "Eye Exam Assessment and Plan",
        "title": "Assessment & Plan",
        "code": [
          {
            "system": "http://snomed.info/sct",
            "code": "386053000",
            "display": "Evaluation procedure"
          }
        ],
        "item": [
          {
            "linkId": "assessment-note",
            "type": "display",
            "text": "Per-problem assessment is documented in the visit's Assessment section, driven by the problem list."
          },
          {
            "linkId": "plan",
            "type": "text",
            "required": true,
            "text": "Plan (treatment, prescriptions, referrals, testing ordered)"
          },
          {
            "linkId": "rx-finalized",
            "type": "boolean",
            "text": "Spectacle Rx finalized and released"
          },
          {
            "linkId": "counseling",
            "type": "text",
            "text": "Patient education / counseling provided"
          },
          {
            "linkId": "rtc",
            "type": "choice",
            "text": "Return to clinic",
            "answerOption": [
              { "valueString": "1 week" },
              { "valueString": "1 month" },
              { "valueString": "3 months" },
              { "valueString": "6 months" },
              { "valueString": "1 year" },
              { "valueString": "PRN" }
            ]
          }
        ]
      },
      "request": { "method": "POST", "url": "Questionnaire" }
    },
